{
  "expo": {
    "name": "AquaGuard",
    "slug": "aquaguard-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "aquaguard",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE"
      },
      "package": "com.jayna.aquaguard"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "plugins": [
      "expo-web-browser",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "projectId": "8ba3f09f-722c-4218-a4db-0c6b6e75b79d"
      }
    }
  }
}